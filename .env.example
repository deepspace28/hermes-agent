# Hermes Agent Environment Configuration
# Copy this file to .env and fill in your API keys

# =============================================================================
# LLM PROVIDER (OpenRouter)
# =============================================================================
# OpenRouter provides access to many models through one API
# All LLM calls go through OpenRouter - no direct provider keys needed
# Get your key at: https://openrouter.ai/keys
# OPENROUTER_API_KEY=

# Default model is configured in ~/.hermes/config.yaml (model.default).
# Use 'hermes model' or 'hermes setup' to change it.
# LLM_MODEL is no longer read from .env — this line is kept for reference only.
# LLM_MODEL=anthropic/claude-opus-4.6

# =============================================================================
# TOOL API KEYS
# =============================================================================

# Zyte API Key - Extraction and spider runs (hermes-zyte-scraper plugin)
# Get at: https://app.zyte.com/o/zyte-api/api-access
# Enable plugin: hermes plugins enable scraping/hermes-zyte-scraper
# ZYTE_API_KEY=

# Scrapy Cloud API Key - Deploy, schedule, and fetch scraping job results
# Get at: https://app.zyte.com/o/settings/apikey
# SCRAPY_CLOUD_API_KEY=

# Scrapy Cloud project ID (numeric, e.g. 867424) for schedule/list jobs
# SCRAPY_CLOUD_PROJECT_ID=
